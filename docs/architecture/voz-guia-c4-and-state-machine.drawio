<mxfile host="app.diagrams.net" modified="2026-11-09T00:34:00.000Z" agent="Antigravity" version="24.0.0" type="device">
  <diagram name="Voz Guia - Arquitetura de 5 Épicos &amp; Fluxo Operacional" id="voz-guia-arch">
    <mxGraphModel dx="1480" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ÉPICO 1: GATILHOS FÍSICOS, HÁPTICA & ESCUDO DE TELA -->
        <mxCell id="e1" value="ÉPICO 1: Core de Acessibilidade, Gatilhos Físicos &amp; Escudo de Tela" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=#f8fafc;strokeColor=#2563eb;fontColor=#1d4ed8;fontStyle=1;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="320" height="500" as="geometry" />
        </mxCell>
        <mxCell id="e1_btn" value="FEAT-1.2 &amp; 1.4: Gatilhos Físicos&#xa;• Hold Volume Down (900ms) = Ouvir&#xa;• 1 Clique Volume = Pânico / Calar / Atender&#xa;• Ambos Volumes (3s) = Emergência SOS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="e1">
          <mxGeometry x="25" y="45" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e1_haptic" value="FEAT-1.3: Motor Háptico &lt; 50ms&#xa;• Vibração + Bip imediato (Zero Escuro)&#xa;• Heartbeat tátil a cada 1s se pensando" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;align=left;spacingLeft=10;" vertex="1" parent="e1">
          <mxGeometry x="25" y="155" width="270" height="75" as="geometry" />
        </mxCell>
        <mxCell id="e1_shield" value="FEAT-1.5: Touch Shield (Escudo de Tela)&#xa;• Bloqueia esbarrões nas bordas curvas&#xa;• Pousar Palma da Mão = Chamar Agente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;align=left;spacingLeft=10;" vertex="1" parent="e1">
          <mxGeometry x="25" y="250" width="270" height="75" as="geometry" />
        </mxCell>
        <mxCell id="e1_a11y" value="FEAT-1.1: VozGuiaAccessibilityService&#xa;• SemanticScreenTreeParser (filtra ruído)&#xa;• ActionDispatcher (Click + Gestures)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#1e3a8a;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="e1">
          <mxGeometry x="25" y="345" width="270" height="120" as="geometry" />
        </mxCell>

        <!-- ÉPICO 2: VOZ HUMANIZADA, ÁUDIO & ROTEADOR HÍBRIDO -->
        <mxCell id="e2" value="ÉPICO 2: Motor de Voz Humanizada, Áudio &amp; Roteador Híbrido" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=#f8fafc;strokeColor=#7c3aed;fontColor=#5b21b6;fontStyle=1;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="400" y="60" width="350" height="500" as="geometry" />
        </mxCell>
        <mxCell id="e2_audio" value="FEAT-2.3: AudioFocus &amp; Anti-Eco&#xa;• Pausa/Baixa YouTube ao abrir escuta&#xa;• Cooldown 150ms pós-TTS (Anti-Self-Trigger)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;fontColor=#1e293b;align=left;spacingLeft=10;" vertex="1" parent="e2">
          <mxGeometry x="30" y="45" width="290" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e2_stt" value="FEAT-2.2: STT Offline (Vosk / Sherpa-ONNX)&#xa;• Reconhecimento pt-BR 100% no aparelho&#xa;• VAD Adaptativo tolerante a pausas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;fontColor=#4c1d95;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="e2">
          <mxGeometry x="30" y="145" width="290" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e2_router" value="FEAT-2.4: Roteador Híbrido em 3 Camadas&#xa;1. Fast-Path Determinístico (&lt; 50ms)&#xa;2. SLM On-Device (Gemma 2B na NPU Dimensity)&#xa;3. Cloud Fallback (Gemini Flash se online)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#6d28d9;fontColor=#2e1065;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="e2">
          <mxGeometry x="30" y="245" width="290" height="115" as="geometry" />
        </mxCell>
        <mxCell id="e2_tts" value="FEAT-2.1: TTS Neural Humanizado pt-BR&#xa;• Cadência calma (0.92x), zero jargão técnico&#xa;• Barge-in instantâneo e comando 'Repete'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;fontColor=#1e293b;align=left;spacingLeft=10;" vertex="1" parent="e2">
          <mxGeometry x="30" y="380" width="290" height="85" as="geometry" />
        </mxCell>

        <!-- ÉPICO 3: MÓDULOS DE AÇÃO AUTÔNOMA -->
        <mxCell id="e3" value="ÉPICO 3: Módulos de Ação Autônoma (WhatsApp, Telefone, YouTube)" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=#f8fafc;strokeColor=#059669;fontColor=#065f46;fontStyle=1;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="790" y="60" width="380" height="500" as="geometry" />
        </mxCell>
        <mxCell id="e3_wa" value="FEAT-3.1: WhatsApp Copiloto&#xa;• NotificationListener: lê e responde sem abrir tela&#xa;• Accessibility: dá Play em áudios recebidos em fila&#xa;• Prioriza Família sobre Grupos + Confirmação de Envio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#064e3b;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="e3">
          <mxGeometry x="30" y="45" width="320" height="125" as="geometry" />
        </mxCell>
        <mxCell id="e3_phone" value="FEAT-3.2: Telefone GSM &amp; WhatsApp Voz&#xa;• Disca por parentesco ('Liga pro meu filho')&#xa;• Viva-voz automático quando sem fone&#xa;• Anuncia quem liga + 1 clique no Volume atende" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;fontColor=#1e293b;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="e3">
          <mxGeometry x="30" y="195" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e3_yt" value="FEAT-3.3: YouTube em Modo Rádio Blindado&#xa;• Busca por voz + Play automático no 1º vídeo longo&#xa;• Bloqueia queda em YouTube Shorts&#xa;• Silent Ad-Skipper: clica sozinho em 'Pular anúncio'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;fontColor=#7f1d1d;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="e3">
          <mxGeometry x="30" y="340" width="320" height="125" as="geometry" />
        </mxCell>

        <!-- ÉPICO 4 & ÉPICO 5 -->
        <mxCell id="e4" value="ÉPICO 4: Memória de Rotina &amp; Grafo Familiar" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=#f8fafc;strokeColor=#d97706;fontColor=#92400e;fontStyle=1;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1210" y="60" width="380" height="240" as="geometry" />
        </mxCell>
        <mxCell id="e4_db" value="FEAT-4.1 a 4.4: SQLite Local (100% Privado)&#xa;• Grafo Familiar + Apelidos Fonéticos ('meu filho' → Gabriel)&#xa;• Utilidades Instantâneas: Hora, Data, Bateria, Remédios&#xa;• Favoritos de Rádio por Horário + Briefing Matinal" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="e4">
          <mxGeometry x="30" y="45" width="320" height="170" as="geometry" />
        </mxCell>

        <mxCell id="e5" value="ÉPICO 5: Modo Cuidador (Gabriel) &amp; Segurança" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=#f8fafc;strokeColor=#334155;fontColor=#0f172a;fontStyle=1;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1210" y="320" width="380" height="240" as="geometry" />
        </mxCell>
        <mxCell id="e5_ui" value="FEAT-5.1 &amp; 5.2: Painel do Familiar + Resiliência&#xa;• Wizard de 6 Permissões Motorola Edge 50 Neo&#xa;• Cadastro Visual de Contatos VIP, Remédios e Voz&#xa;• Avisos Falados de Bateria (20%/10%) e Carregador&#xa;• Comando SOS Emergência → Liga pro Gabriel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#4f46e5;fontColor=#f8fafc;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="e5">
          <mxGeometry x="30" y="45" width="320" height="170" as="geometry" />
        </mxCell>

